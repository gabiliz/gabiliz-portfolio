{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // next-env.d.ts is generated by next build and says not to edit it
    "includes": ["src/**", "*.js", "*.json", "!next-env.d.ts", "!package-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSameLine": false
    }
  },
  "css": {
    "parser": {
      // globals.css is Tailwind 4: @import 'tailwindcss', @theme, @utility, @custom-variant
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Every list here comes from a build-time JSON file or a fixed-length
        // decorative array, and none of them reorder. The lists that *are*
        // filtered or sorted at runtime (projects, credentials, the shelf)
        // already key on a real id, so this rule has nothing left to catch.
        "noArrayIndexKey": "off"
      },
      "complexity": {
        // The only !important in the project is the prefers-reduced-motion
        // override in globals.css, which has to beat utility and inline styles.
        "noImportantStyles": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            // Node builtins and packages first, then the "@/" path alias, then
            // relative paths — the blank lines are the grouping the codebase
            // already used by hand.
            "groups": [[":NODE:", ":PACKAGE:"], ":BLANK_LINE:", "@/**", ":BLANK_LINE:", ":PATH:"]
          }
        }
      }
    }
  }
}
